# Frontend environment variables

# When set, all API requests will use this absolute base URL.
# Example: http://localhost:3001
REACT_APP_API_BASE_URL=

# When set to 'true', the client will use relative URLs (e.g., /api/chat),
# which allows CRA dev server proxy to forward requests to the backend.
# In dev, the proxy target is defined in package.json ("proxy": "http://localhost:3001").
REACT_APP_USE_PROXY=true
