# Create React App environment variables (must be prefixed with REACT_APP_)
# If you want the dev server to accept connections from a custom host (e.g., workspace preview),
# set HOST to 0.0.0.0 so it binds correctly.
HOST=0.0.0.0
PORT=3000

# Backend connection options (choose one strategy)
# 1) Use CRA dev proxy (package.json "proxy" is set). Use relative URLs like /api/chat.
REACT_APP_USE_PROXY=true

# 2) Or call backend directly:
# REACT_APP_API_BASE_URL=http://localhost:3001

# Optional: Origin to use in backend CORS (if not using proxy)
# FRONTEND_ORIGIN is consumed by the backend, not CRA, but documenting here for convenience.
# FRONTEND_ORIGIN=http://localhost:3000
